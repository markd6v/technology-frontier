# Copy to .env.local for local dev. Production values live in Vercel env vars.

# Local: `npm run db:start` prints this URL. Production: Neon *pooled* connection string.
DATABASE_URL=postgres://postgres@localhost:54329/frontier

# Shared secret for /api/jobs/* (Vercel Cron sends it automatically as a Bearer token;
# the GitHub Actions hourly workflow reads it from repo secrets).
CRON_SECRET=change-me

# Claude API key for the assess step (content/config.yaml sets the model and the monthly cap).
# Without it, ingestion still runs and items stay unassessed.
ANTHROPIC_API_KEY=
