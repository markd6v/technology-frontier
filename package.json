{
  "name": "technology-frontier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "scripts/db.sh start",
    "db:stop": "scripts/db.sh stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/cli/migrate.ts",
    "job": "node --env-file-if-exists=.env.local --import tsx src/cli/job.ts",
    "assess:local": "scripts/assess-cron.sh run",
    "cron:install": "scripts/assess-cron.sh install",
    "cron:uninstall": "scripts/assess-cron.sh uninstall",
    "cron:status": "scripts/assess-cron.sh status",
    "validate:content": "node --import tsx src/cli/validate-content.ts",
    "vercel-build": "npm run db:migrate && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "type": "module"
}
